# resolve the BotWave dir
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
BW_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"

"$BW_DIR/venv/bin/python3" "$BW_DIR"/autorun/autorun.py "$@"
